{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HashValidatorPlus",
  "version": "0.3.0",
  "identifier": "com.hashvalidatorplus.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "文件哈希校验工具",
        "width": 1300,
        "height": 850,
        "minWidth": 900,
        "minHeight": 750,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
