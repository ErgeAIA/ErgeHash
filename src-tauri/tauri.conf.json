{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ErgeHash",
  "version": "0.9.96",
  "identifier": "com.ergehash.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文件哈希校验工具",
        "devtools": false,
        "width": 1300,
        "height": 850,
        "minWidth": 900,
        "minHeight": 750,
        "decorations": false,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer.nsh"
      }
    }
  }
}
